# Copy to .env and fill in real values. Never commit .env.
# See .gitignore - .env is ignored.

# PostgreSQL connection string (Supabase pooler in this project).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# Supabase project URL. The backend verifies Supabase Auth JWTs using its JWKS.
SUPABASE_URL=https://your-project.supabase.co

# HTTP port the API listens on (defaults to 3000 when unset).
PORT=3000

# goose migration configuration. GOOSE_MIGRATION_DIR is relative to the repo root.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgresql://USER:PASSWORD@HOST:5432/postgres
GOOSE_MIGRATION_DIR=./migrations